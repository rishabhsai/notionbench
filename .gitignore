node_modules/
dist/
# results/* not results/ — git will not descend into an ignored directory, so a
# negation inside one never applies.
results/*
# …except the small archive of the run data behind the published numbers. Named
# explicitly, not globbed: results/archive/ also holds a 36 MB tree of agent
# transcripts and artifacts that stays local.
!results/archive/
results/archive/*
!results/archive/run-*.tar.gz

# Vendored into the published tarball by packages/runner prepack; evals/ at the
# repo root is the source of truth. postpack removes it again — this is a
# backstop for an interrupted pack.
packages/runner/evals/
packages/runner/dist/node_modules/
packages/runner/package.json.prepack-backup
*.tgz
.env
*.local
.DS_Store
notion_state.json

# internal/personal — never publish
PLAN.md
docs/PLAN.md
private/
notes/
runconfig.local.*
# Drafts, launch copy, outreach notes. These live in private/ and belong to the
# author, not the project.
*-THREAD.md
*-DRAFT.md
