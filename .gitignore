node_modules/
dist/
# results/* not results/ — git will not descend into an ignored directory, so a
# negation inside one never applies.
results/*
# …except the archived run data behind the published numbers. Everything else
# under results/ is regenerable; this is not, and the VPS it lived on is billed.
!results/archive/
!results/archive/*.tar.gz

# Vendored into the published tarball by packages/runner prepack; evals/ at the
# repo root is the source of truth. postpack removes it again — this is a
# backstop for an interrupted pack.
packages/runner/evals/
packages/runner/dist/node_modules/
packages/runner/package.json.prepack-backup
*.tgz
.env
*.local
.DS_Store
notion_state.json

# internal/personal — never publish
PLAN.md
docs/PLAN.md
private/
notes/
runconfig.local.*
